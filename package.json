{
  "name": "membrane-memory",
  "version": "0.2.7",
  "description": "Temporal-aware, local-first, explainable memory engine for AI agents. Zero dependencies, single SQLite file, MCP server included.",
  "type": "module",
  "license": "MIT",
  "author": "yuannuo233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuannuo233/membrane-memory.git"
  },
  "homepage": "https://github.com/yuannuo233/membrane-memory#readme",
  "bugs": {
    "url": "https://github.com/yuannuo233/membrane-memory/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "membrane-memory": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "web/index.html",
    "web/app.css",
    "web/app.js",
    "web/assets/favicon.ico",
    "web/assets/mascot.svg",
    "README.md",
    "README.en.md",
    "使用场景.md",
    "适配配置/",
    "Dockerfile",
    "llms.txt",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "doctor": "node dist/cli.js doctor",
    "embed-purge": "node dist/cli.js embed-purge",
    "bench:scale": "node scripts/bench-scale.mjs",
    "eval:extract": "node scripts/eval-extract.mjs",
    "check": "node scripts/check-consistency.mjs && node scripts/scan-stale-versions.mjs",
    "prepublishOnly": "npm run build && npm run check"
  },
  "keywords": [
    "agent-memory",
    "ai-memory",
    "llm-memory",
    "memory-engine",
    "long-term-memory",
    "chatbot-memory",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "agent",
    "sqlite",
    "temporal",
    "local-first",
    "offline",
    "privacy",
    "self-hosted",
    "explainable",
    "explainable-ai",
    "rag",
    "memory",
    "claude",
    "cursor",
    "cline",
    "zero-dependency",
    "typescript"
  ],
  "dependencies": {
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
